+def _read_colmap_cameras(scene_path: Path, colmap_subdir: str):
+    """STAC: the keyframes' w2c and pinhole K from the COLMAP text model (the distortion, < 1 px here, ignored)."""
+    cams = {}
+    for line in (scene_path / colmap_subdir / "cameras.txt").read_text().splitlines():
+        if line.startswith("#") or not line.strip():
+            continue
+        v = line.split(); cams[int(v[0])] = (int(v[2]), int(v[3]), [float(x) for x in v[4:8]])
+    R_list, t_list, K_list, hw = [], [], [], None
+    from scipy.spatial.transform import Rotation
+    for line in (scene_path / colmap_subdir / "images.txt").read_text().splitlines():
+        if line.startswith("#") or not line.strip():
+            continue
+        v = line.split()
+        if len(v) < 10:
+            continue
+        qw, qx, qy, qz = (float(x) for x in v[1:5]); t = [float(x) for x in v[5:8]]
+        W, H, (fx, fy, cx, cy) = cams[int(v[8])]
+        R_list.append(Rotation.from_quat([qx, qy, qz, qw]).as_matrix()); t_list.append(t); K_list.append([fx, fy, cx, cy]); hw = (H, W)
+    return np.asarray(R_list, np.float32), np.asarray(t_list, np.float32), np.asarray(K_list, np.float32), hw
+
+
+def _make_unseen_hook(points_path, scene_path, colmap_subdir, m_c2o, chunk_indices, R: int, cloud_coords, record, out_path, device):
+    """STAC: returns the hook that merges the MODEL's sparse structure with the cloud's voxels: a generated voxel
+    not in the cloud's set is kept only when NO keyframe saw through it — in every keyframe that frames it, it
+    lies at or behind the cloud's z-buffer (min-filtered, half resolution) within one voxel. The record carries
+    the per-chunk counts (generated, candidates, vetoed as seen free, added as unseen)."""
+    Rw, tw, Kw, (H, W) = _read_colmap_cameras(scene_path, colmap_subdir)
+    P = torch.from_numpy(np.load(points_path).astype(np.float32)).to(device)
+    Rw_t = torch.from_numpy(Rw).to(device); tw_t = torch.from_numpy(tw).to(device); Kw_t = torch.from_numpy(Kw).to(device)
+    Hh, Wh = H // 2, W // 2
+    FAR = 1.0e6
+    zbuf = torch.full((len(Rw), Hh * Wh), FAR, device=device)
+    for f in range(len(Rw)):
+        pc = P @ Rw_t[f].T + tw_t[f]
+        z = pc[:, 2]; front = z > 0.2
+        fx, fy, cx, cy = Kw_t[f]
+        u = ((fx * pc[front, 0] / z[front] + cx) * 0.5).long(); v = ((fy * pc[front, 1] / z[front] + cy) * 0.5).long()
+        inb = (u >= 0) & (u < Wh) & (v >= 0) & (v < Hh)
+        zbuf[f].scatter_reduce_(0, (v[inb] * Wh + u[inb]), z[front][inb], reduce="amin")
+    zbuf = zbuf.view(len(Rw), 1, Hh, Wh)
+    zbuf = -torch.nn.functional.max_pool2d(-zbuf, kernel_size=5, stride=1, padding=2)      # the min filter of the hole audit
+    zbuf = zbuf.view(len(Rw), Hh, Wh)
+    del P
+    behind_vox = 2.0            # voxels behind the measured surface a generated voxel may still sit (declared, not measured)
+    record["unseen"] = {"keyframes": int(len(Rw)), "zbuffer_hw": [Hh, Wh], "tau_vox": 1.0, "behind_vox": behind_vox, "chunks": []}
+
+    def hook(generated):
+        merged = []
+        for n, c in enumerate(chunk_indices):
+            M = m_c2o[c].detach().cpu().numpy().astype(np.float64); size = float(M[0, 0]); centre = torch.tensor(M[:3, 3], dtype=torch.float32, device=device)
+            tau = size / R
+            gen = generated[n][:, 1:].long().to(device); cl = cloud_coords[n][:, 1:].long().to(device)
+            lin_g = (gen[:, 0] * R + gen[:, 1]) * R + gen[:, 2]; lin_c = (cl[:, 0] * R + cl[:, 1]) * R + cl[:, 2]
+            cand = gen[~torch.isin(lin_g, lin_c)]
+            keep = torch.zeros(len(cand), dtype=torch.bool, device=device)
+            if len(cand):
+                pw = centre + ((cand.float() + 0.5) / R - 0.5) * size                          # world centres [N, 3]
+                seen_free = torch.zeros(len(cand), dtype=torch.bool, device=device)
+                near_behind = torch.zeros(len(cand), dtype=torch.bool, device=device)   # just behind a measured surface
+                in_hole = torch.zeros(len(cand), dtype=torch.bool, device=device)       # a camera looked there, nothing measured
+                for f0 in range(0, len(Rw), 32):
+                    Rb, tb, Kb = Rw_t[f0:f0 + 32], tw_t[f0:f0 + 32], Kw_t[f0:f0 + 32]
+                    pc = torch.einsum("fij,nj->fni", Rb, pw) + tb[:, None, :]                  # [F, N, 3]
+                    z = pc[..., 2]; front = z > 0.2; zs = torch.where(front, z, torch.ones_like(z))
+                    u = ((Kb[:, 0, None] * pc[..., 0] / zs + Kb[:, 2, None]) * 0.5).long(); v = ((Kb[:, 1, None] * pc[..., 1] / zs + Kb[:, 3, None]) * 0.5).long()
+                    inb = front & (u >= 0) & (u < Wh) & (v >= 0) & (v < Hh)
+                    uc = u.clamp(0, Wh - 1); vc = v.clamp(0, Hh - 1)
+                    zb = zbuf[f0:f0 + 32][torch.arange(len(Rb), device=device)[:, None], vc, uc]
+                    measured = inb & (zb < FAR)
+                    seen_free |= (measured & (z < zb - tau)).any(0)
+                    near_behind |= (measured & (z <= zb + behind_vox * tau)).any(0)
+                    in_hole |= (inb & (zb >= FAR)).any(0)
+                # kept: never seen free, and either just behind a measured surface (its thickness, its underside)
+                # or where a camera looked and the reconstruction measured nothing (a hole) — never a volume deep
+                # behind every surface (a room the model imagines behind a wall) nor a place no camera framed
+                keep = ~seen_free & (near_behind | in_hole)
+            add = cand[keep]
+            allc = torch.unique(torch.cat([cl, add], 0), dim=0).int()
+            merged.append(torch.cat([torch.zeros(len(allc), 1, dtype=torch.int32, device=device), allc], 1))
+            record["unseen"]["chunks"].append({"chunk": int(c), "generated": int(len(gen)), "cloud": int(len(cl)), "candidates": int(len(cand)),
+                                               "vetoed_seen_free": int(seen_free.sum()) if len(cand) else 0,
+                                               "rejected_deep_or_unframed": int((~seen_free & ~(near_behind | in_hole)).sum()) if len(cand) else 0,
+                                               "added_unseen": int(len(add)), "active": int(len(allc))})
+        with (Path(out_path) / "coords_from_points.json").open("w", encoding="utf-8") as fh:
+            json.dump(record, fh, indent=2)
+        print(f"[STAC] cloud+unseen: added {[r['added_unseen'] for r in record['unseen']['chunks']]} unseen voxels per chunk "
+              f"(seen free {[r['vetoed_seen_free'] for r in record['unseen']['chunks']]}, deep/unframed {[r['rejected_deep_or_unframed'] for r in record['unseen']['chunks']]}); "
+              f"active {[r['active'] for r in record['unseen']['chunks']]}")
+        return merged
+    return hook
+
