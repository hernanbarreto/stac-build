+class StacDump(MapRecorder):
+    """STAC (2026-11-03): the map recorder that also keeps, for every frame it saves, that frame's FULL pass — its
+    points in its submap's frame, confidence, sky and camera — so ``save_frames`` writes one record per frame: the
+    depth along the WORLD camera's axis (the submap's final Sim(3) applied: depth times its scale), the pinhole K the
+    pass's points follow (least squares of u = fx x/z + cx, v = fy y/z + cy over the valid pixels, pixel centres at
+    integers), the world camera-to-world, the confidence and the sky. The map itself is unchanged."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.full = {}
+
+    def add(self, sm, images):
+        super().add(sm, images)
+        pts, conf, sky = sm.dense
+        mid = 0.5 * (sm.start + sm.end - 1)
+        for i, f in enumerate(sm.frames):
+            slot, dist = f // self.every, abs(f - mid)
+            got = self.best.get(slot)
+            if got is not None and got[1] is sm and got[0] == dist:
+                self.full[slot] = (f, sm, pts[i].half().cpu(), conf[i].float().cpu(),
+                                   None if sky is None else sky[i].bool().cpu(), sm.poses[i].double().cpu())
+
+    def drop(self, sm):
+        super().drop(sm)
+        self.full = {s: v for s, v in self.full.items() if v[1] is not sm}
+
+    def save_frames(self, out_dir, result):
+        """One ``frame_<input index>.npz`` per saved frame under ``out_dir``; returns how many."""
+        import os
+        if not result.submaps or result.submap_poses is None:
+            return 0
+        os.makedirs(out_dir, exist_ok=True)
+        index = {id(sm): k for k, sm in enumerate(result.submaps)}
+        n = 0
+        for slot in sorted(self.full):
+            f, sm, p, c, sky, T = self.full[slot]
+            k = index.get(id(sm))
+            if k is None:
+                continue
+            g = result.submap_poses[k].double().cpu()
+            R, t, s = quat_to_rmat(g[3:7]), g[:3], float(g[7])
+            pc = (p.double() - T[:3, 3]) @ T[:3, :3]
+            z = pc[..., 2]
+            H, W = z.shape
+            ok = torch.isfinite(pc).all(-1) & (z > 1e-6)
+            v, u = torch.meshgrid(torch.arange(H, dtype=torch.float64), torch.arange(W, dtype=torch.float64),
+                                  indexing='ij')
+            xs, ys = (pc[..., 0] / z)[ok], (pc[..., 1] / z)[ok]
+            A = torch.stack([xs, torch.ones_like(xs)], -1)
+            fx, cx = torch.linalg.lstsq(A, u[ok][:, None]).solution[:, 0].tolist()
+            A = torch.stack([ys, torch.ones_like(ys)], -1)
+            fy, cy = torch.linalg.lstsq(A, v[ok][:, None]).solution[:, 0].tolist()
+            ru = (fx * xs + cx - u[ok]).abs()
+            rv = (fy * ys + cy - v[ok]).abs()
+            c2w = torch.eye(4, dtype=torch.float64)
+            c2w[:3, :3] = R @ T[:3, :3]
+            c2w[:3, 3] = s * (R @ T[:3, 3]) + t
+            depth = torch.where(ok, z * s, torch.zeros_like(z))
+            if sky is not None:
+                depth = torch.where(sky, torch.zeros_like(depth), depth)
+            np.savez(os.path.join(out_dir, f'frame_{f:06d}.npz'), frame=f, c2w=c2w.numpy(),
+                     K=np.array([[fx, 0, cx], [0, fy, cy], [0, 0, 1.0]]), depth=depth.float().numpy(),
+                     conf=c.numpy(), sky=(np.zeros((H, W), bool) if sky is None else sky.numpy()),
+                     submap=k, scale=s, k_residual_px=float(torch.cat([ru, rv]).median()))
+            n += 1
+        return n
