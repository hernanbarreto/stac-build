{
  "name": "stac-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "WEB_ONLY=true vite",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build:xr": "npm run provision:xr8 && WEB_ONLY=true vite build --base=/app/",
    "provision:xr8": "mkdir -p ../static/xr8 && cp -r node_modules/@8thwall/engine-binary/dist/* ../static/xr8/"
  },
  "dependencies": {
    "@types/three": "^0.182.0",
    "chart.js": "^4.5.1",
    "lucide-react": "^0.575.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "three": "^0.182.0",
    "three-mesh-bvh": "^0.9.14",
    "web-ifc": "^0.0.75"
  },
  "devDependencies": {
    "@8thwall/engine-binary": "^1.0.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js"
}
