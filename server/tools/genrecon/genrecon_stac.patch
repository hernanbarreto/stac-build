+        R_list.append(Rotation.from_quat([qx, qy, qz, qw]).as_matrix()); t_list.append(t); K_list.append([fx, fy, cx, cy]); hw = (H, W)
+    return np.asarray(R_list, np.float32), np.asarray(t_list, np.float32), np.asarray(K_list, np.float32), hw
+
+
+def _make_unseen_hook(points_path, scene_path, colmap_subdir, m_c2o, chunk_indices, R: int, cloud_coords, record, out_path, device,
+                      objects=None, mode: str = "cloud+unseen"):
+    """STAC: returns the hook that merges the MODEL's sparse structure with the cloud's voxels: a generated voxel
+    not in the cloud's set is kept only when NO keyframe saw through it — in every keyframe that frames it, it
+    lies at or behind the cloud's z-buffer (min-filtered, half resolution) within one voxel. The record carries
+    the per-chunk counts (generated, candidates, vetoed as seen free, added as unseen)."""
+    Rw, tw, Kw, (H, W) = _read_colmap_cameras(scene_path, colmap_subdir)
+    P = torch.from_numpy(np.load(points_path).astype(np.float32)).to(device)
+    Rw_t = torch.from_numpy(Rw).to(device); tw_t = torch.from_numpy(tw).to(device); Kw_t = torch.from_numpy(Kw).to(device)
+    Hh, Wh = H // 2, W // 2
+    FAR = 1.0e6
+    zbuf = torch.full((len(Rw), Hh * Wh), FAR, device=device)
+    for f in range(len(Rw)):
+        pc = P @ Rw_t[f].T + tw_t[f]
+        z = pc[:, 2]; front = z > 0.2
+        fx, fy, cx, cy = Kw_t[f]
+        u = ((fx * pc[front, 0] / z[front] + cx) * 0.5).long(); v = ((fy * pc[front, 1] / z[front] + cy) * 0.5).long()
+        inb = (u >= 0) & (u < Wh) & (v >= 0) & (v < Hh)
+        zbuf[f].scatter_reduce_(0, (v[inb] * Wh + u[inb]), z[front][inb], reduce="amin")
+    zbuf = zbuf.view(len(Rw), 1, Hh, Wh)
+    zbuf = -torch.nn.functional.max_pool2d(-zbuf, kernel_size=5, stride=1, padding=2)      # the min filter of the hole audit
+    zbuf = zbuf.view(len(Rw), Hh, Wh)
+    del P
+    behind_vox = 2.0            # voxels behind the measured surface a generated voxel may still sit (declared, not measured)
+    record["unseen"] = {"mode": mode, "keyframes": int(len(Rw)), "zbuffer_hw": [Hh, Wh], "tau_vox": 1.0, "behind_vox": behind_vox,
+                        "objects": (len(objects[0]) if objects is not None else 0), "chunks": []}
+
+    def hook(generated):
+        merged = []
+        for n, c in enumerate(chunk_indices):
+            M = m_c2o[c].detach().cpu().numpy().astype(np.float64); size = float(M[0, 0]); centre = torch.tensor(M[:3, 3], dtype=torch.float32, device=device)
+            tau = size / R
+            gen = generated[n][:, 1:].long().to(device); cl = cloud_coords[n][:, 1:].long().to(device)
+            lin_g = (gen[:, 0] * R + gen[:, 1]) * R + gen[:, 2]; lin_c = (cl[:, 0] * R + cl[:, 1]) * R + cl[:, 2]
+            cand = gen[~torch.isin(lin_g, lin_c)]
+            keep = torch.zeros(len(cand), dtype=torch.bool, device=device)
+            if len(cand):
+                pw = centre + ((cand.float() + 0.5) / R - 0.5) * size                          # world centres [N, 3]
+                seen_free = torch.zeros(len(cand), dtype=torch.bool, device=device)
+                near_behind = torch.zeros(len(cand), dtype=torch.bool, device=device)   # just behind a measured surface
+                in_hole = torch.zeros(len(cand), dtype=torch.bool, device=device)       # a camera looked there, nothing measured
+                for f0 in range(0, len(Rw), 32):
+                    Rb, tb, Kb = Rw_t[f0:f0 + 32], tw_t[f0:f0 + 32], Kw_t[f0:f0 + 32]
+                    pc = torch.einsum("fij,nj->fni", Rb, pw) + tb[:, None, :]                  # [F, N, 3]
+                    z = pc[..., 2]; front = z > 0.2; zs = torch.where(front, z, torch.ones_like(z))
+                    u = ((Kb[:, 0, None] * pc[..., 0] / zs + Kb[:, 2, None]) * 0.5).long(); v = ((Kb[:, 1, None] * pc[..., 1] / zs + Kb[:, 3, None]) * 0.5).long()
+                    inb = front & (u >= 0) & (u < Wh) & (v >= 0) & (v < Hh)
+                    uc = u.clamp(0, Wh - 1); vc = v.clamp(0, Hh - 1)
+                    zb = zbuf[f0:f0 + 32][torch.arange(len(Rb), device=device)[:, None], vc, uc]
+                    measured = inb & (zb < FAR)
+                    seen_free |= (measured & (z < zb - tau)).any(0)
+                    near_behind |= (measured & (z <= zb + behind_vox * tau)).any(0)
+                    in_hole |= (inb & (zb >= FAR)).any(0)
+                # kept: never seen free, and either just behind a measured surface (its thickness, its underside)
+                # or where a camera looked and the reconstruction measured nothing (a hole) — never a volume deep
+                # behind every surface (a room the model imagines behind a wall) nor a place no camera framed
+                keep = ~seen_free & (near_behind | in_hole)
+                if mode == "cloud+objects":
+                    # only INSIDE a segmented object's box (grown by one voxel), never where a camera saw empty
+                    if objects is None:
+                        keep = torch.zeros_like(keep)
+                    else:
+                        in_obj = torch.from_numpy(_inside_boxes(pw.detach().cpu().numpy().astype(np.float64), objects, tau)).to(device)
+                        # no free-space veto inside the box: a leg with no points lies "in front of" the floor
+                        # the z-buffer measured behind it — the box is the constraint, the images condition the model
+                        keep = in_obj
+            add = cand[keep]
+            allc = torch.unique(torch.cat([cl, add], 0), dim=0).int()
+            merged.append(torch.cat([torch.zeros(len(allc), 1, dtype=torch.int32, device=device), allc], 1))
+            record["unseen"]["chunks"].append({"chunk": int(c), "generated": int(len(gen)), "cloud": int(len(cl)), "candidates": int(len(cand)),
+                                               "vetoed_seen_free": int(seen_free.sum()) if len(cand) else 0,
+                                               "rejected_deep_or_unframed": int((~seen_free & ~(near_behind | in_hole)).sum()) if len(cand) else 0,
+                                               "added_unseen": int(len(add)), "active": int(len(allc))})
+        with (Path(out_path) / "coords_from_points.json").open("w", encoding="utf-8") as fh:
+            json.dump(record, fh, indent=2)
+        print(f"[STAC] cloud+unseen: added {[r['added_unseen'] for r in record['unseen']['chunks']]} unseen voxels per chunk "
+              f"(seen free {[r['vetoed_seen_free'] for r in record['unseen']['chunks']]}, deep/unframed {[r['rejected_deep_or_unframed'] for r in record['unseen']['chunks']]}); "
+              f"active {[r['active'] for r in record['unseen']['chunks']]}")
+        return merged
+    return hook
+
+
+def _load_objects(scene_path: Path):
+    """STAC: the segmented objects' boxes (objects.json, GenRecon's frame): centres [B, 3], axes [B, 3, 3] (columns), half [B, 3]."""
+    f = Path(scene_path) / "objects.json"
+    if not f.exists():
+        return None
+    o = json.loads(f.read_text(encoding="utf-8"))["objects"]
+    if not o:
+        return None
+    return (np.asarray([x["center"] for x in o], np.float64), np.asarray([x["axes"] for x in o], np.float64),
+            np.asarray([x["half_extents"] for x in o], np.float64), [x["label"] for x in o])
+
+
+def _inside_boxes(P: np.ndarray, objects, dilate: float) -> np.ndarray:
+    """Which points (N, 3) lie inside at least one object box, each box grown by ``dilate`` on every side."""
+    C, A, H, _ = objects
+    inside = np.zeros(len(P), dtype=bool)
+    for b in range(len(C)):
+        local = (P - C[b]) @ A[b]                       # columns are the axes → local = Aᵀ (p − c)
+        inside |= np.all(np.abs(local) <= H[b] + dilate, axis=1)
+    return inside
+
+
+def _coords_from_layout(lay_path, cells_path, m_c2o, chunk_indices, R: int, out_path):
+    """STAC 2026-11-05 (USER: "que decidan las fotos, no la cuenta de puntos"): the active voxels of every chunk are
+    the lattice cells the adapter found occupied by the points the keyframes' vote kept (server/tools/genrecon/
+    presence.py) — one lattice for every cube, so a cell is the same voxel whichever cube holds it."""
+    with Path(lay_path).open("r", encoding="utf-8") as f:
+        L = json.load(f)
+    if int(L["R"]) != int(R):
+        raise RuntimeError(f"layout.json was planned for {L['R']}³ voxels per cube, the model's grid is {R}³")
+    A = np.load(cells_path).astype(np.int64)
+    o, v = np.asarray(L["origin"], np.float64), float(L["voxel"])
+    coords, record = [], {"active_cells": int(len(A)), "resolution": int(R), "voxel_m": v, "source": "layout.json", "chunks": []}
+    for c in chunk_indices:
+        M = m_c2o[c].detach().cpu().numpy().astype(np.float64)
+        size = float(M[0, 0]); centre = M[:3, 3]
+        f = (centre - 0.5 * size - o) / v
+        corner = np.round(f).astype(np.int64)
+        if np.abs(f - corner).max() > 1e-3 or abs(size / v - R) > 1e-3:
+            raise RuntimeError(f"chunk {c} is off the layout's lattice (corner offset {np.abs(f - corner).max():.4f} voxel)")
+        sel = np.all((A >= corner) & (A < corner + R), axis=1)
+        vox = A[sel] - corner
+        if len(vox) == 0:
+            raise RuntimeError(f"chunk {c}: no active cell of the layout inside it")
+        xyz = torch.from_numpy(vox.astype(np.int32))
+        coords.append(torch.cat([torch.zeros(len(xyz), 1, dtype=torch.int32), xyz], 1))
+        record["chunks"].append({"chunk": int(c), "voxels_active": int(len(vox))})
+    with (Path(out_path) / "coords_from_points.json").open("w", encoding="utf-8") as f:
+        json.dump(record, f, indent=2)
+    print(f"[STAC] coords from the layout's active cells ({len(A):,}): {[r['voxels_active'] for r in record['chunks']]} per chunk")
+    return coords, record
+
+
+def _coords_from_points(points_path, m_c2o, chunk_indices, R: int, min_points: int, out_path, objects=None, min_points_objects: int = 2,
+                        extra_points_path=None) -> list[torch.Tensor]:
+    """STAC: the active voxels of every kept chunk from the MEASURED cloud. Voxel (i, j, k) of a chunk covers
+    [i/R - 0.5, (i+1)/R - 0.5) of its unit cube on each axis (the convention of ``_global_grid_points``);
+    it is active when it holds ``min_points`` points of the cloud. The record (coords_from_points.json)
+    carries the per-chunk occupancy distribution the bound sat in."""
+    lay, cells_p = Path(points_path).parent / "layout.json", Path(points_path).parent / "active_cells.npy"
+    if objects is None and extra_points_path is None and lay.exists() and cells_p.exists():
+        return _coords_from_layout(lay, cells_p, m_c2o, chunk_indices, R, out_path)
+    P = np.load(points_path).astype(np.float64)
+    E = np.load(extra_points_path).astype(np.float64) if extra_points_path is not None else None
+    coords, record = [], {"points": int(len(P)), "extra_points": (int(len(E)) if E is not None else 0), "resolution": int(R), "min_points": int(min_points), "chunks": []}
+    for c in chunk_indices:
+        M = m_c2o[c].detach().cpu().numpy().astype(np.float64)       # chunk unit cube → world (scale = chunk size)
+        size = float(M[0, 0]); centre = M[:3, 3]
+        u = (P - centre) / size
+        inside = np.all(np.abs(u) < 0.5, axis=1)
+        ijk = np.clip(np.floor((u[inside] + 0.5) * R).astype(np.int64), 0, R - 1)
+        lin = (ijk[:, 0] * R + ijk[:, 1]) * R + ijk[:, 2]
+        uniq, counts = np.unique(lin, return_counts=True)
+        vox_all = np.stack([uniq // (R * R), (uniq // R) % R, uniq % R], 1)
+        thr = np.full(len(uniq), min_points)
+        n_obj = 0
+        if objects is not None:
+            centres_w = centre + ((vox_all + 0.5) / R - 0.5) * size
+            in_obj = _inside_boxes(centres_w, objects, size / R)
+            thr[in_obj] = min_points_objects; n_obj = int((in_obj & (counts >= min_points_objects) & (counts < min_points)).sum())
+        keep = counts >= thr
+        vox = vox_all[keep]
+        n_extra = 0
+        if E is not None:
+            ue = (E - centre) / size; ie = np.all(np.abs(ue) < 0.5, axis=1)
+            if ie.any():
+                ijk_e = np.clip(np.floor((ue[ie] + 0.5) * R).astype(np.int64), 0, R - 1)
+                lin_e = np.unique((ijk_e[:, 0] * R + ijk_e[:, 1]) * R + ijk_e[:, 2])
+                lin_k = (vox[:, 0] * R + vox[:, 1]) * R + vox[:, 2]
+                lin_new = np.setdiff1d(lin_e, lin_k)
+                n_extra = int(len(lin_new))
+                if n_extra:
+                    vox = np.concatenate([vox, np.stack([lin_new // (R * R), (lin_new // R) % R, lin_new % R], 1)])
+        if len(vox) == 0:
+            raise RuntimeError(f"chunk {c}: no voxel of the cloud holds {min_points} points")
+        xyz = torch.from_numpy(vox.astype(np.int32))
+        coords.append(torch.cat([torch.zeros(len(xyz), 1, dtype=torch.int32), xyz], 1))
+        record["chunks"].append({"chunk": int(c), "points_inside": int(inside.sum()), "voxels_occupied": int(len(uniq)),
+                                 "voxels_active": int(len(vox)), "sparse_in_objects_added": n_obj, "extra_voxels_added": n_extra,
+                                 "count_p10_p50_p90": [float(v) for v in np.percentile(counts, [10, 50, 90])]})
+    with (Path(out_path) / "coords_from_points.json").open("w", encoding="utf-8") as f:
+        json.dump(record, f, indent=2)
+    print(f"[STAC] coords from the cloud ({len(P):,} points): {[r['voxels_active'] for r in record['chunks']]} active voxels per chunk at R={R}")
+    return coords, record
+
