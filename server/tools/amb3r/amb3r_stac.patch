+    def _save_light(self, out, result, index):
+        """STAC: ``out`` (map_<seq>_light.npz) — per saved frame, in frame order: its input index, its camera-to-world
+        and its depth through its submap's final Sim(3) (the depth times the submap's scale), its K on the model grid,
+        the submap, its scale, the K fit's median residual; and the pixel stride. Returns (0, frames written)."""
+        rows = []
+        for slot in sorted(self.best):
+            _, sm, f, d, T, k4, k_res = self.best[slot]
+            k = index.get(id(sm))
+            if k is None:
+                continue
+            g = result.submap_poses[k].double().cpu()
+            R, t, s = quat_to_rmat(g[3:7]), g[:3], float(g[7])
+            M = torch.eye(4, dtype=torch.float64)
+            M[:3, :3] = R @ T[:3, :3]
+            M[:3, 3] = s * (R @ T[:3, 3]) + t
+            fx, fy, cx, cy = k4
+            rows.append((int(f), M.numpy(), (d.double() * s).float().numpy(),
+                         np.array([[fx, 0.0, cx], [0.0, fy, cy], [0.0, 0.0, 1.0]]), k, s, k_res))
+        if not rows:
+            return None
+        np.savez(out, frame=np.array([r[0] for r in rows], np.int64), c2w=np.stack([r[1] for r in rows]),
+                 depth=np.stack([r[2] for r in rows]), K=np.stack([r[3] for r in rows]),
+                 submap=np.array([r[4] for r in rows], np.int64), scale=np.array([r[5] for r in rows]),
+                 k_residual_px=np.array([r[6] for r in rows]), stride=np.int64(self.stride))
+        return (0, len(rows))
