# STAC Build — the pod's secrets. Copy to /workspace/.env on a new volume and fill it in; the rebuild
# copies nothing of it into the repo (.env is git-ignored). KEEP A COPY OF THE FILLED FILE OFF THE POD.
#
# Hugging Face — a READ token of the account that was granted the gated repos:
#   facebook/sam3, facebook/sam3.1, facebook/VGGT-Omega   (https://huggingface.co/settings/tokens)
export HF_TOKEN=

# GitHub — the user and a token with read access to the private repos
#   hernanbarreto/stac-build and hernanbarreto/Depth-Anything-3
export GIT_USER=
export GIT_TOKEN=

# DINOv3 — Meta's signed download link. IT EXPIRES (the one of 2026-10-04 was dead on 2026-11-18): ask
# for a new one at https://ai.meta.com/resources/models-and-libraries/dinov3-downloads/ and paste here
# the link of ANY of the files Meta mails (or its form with a * in place of the file). Without it the
# rebuild completes everything else and reports the two DINOv3 checkpoints (PointDiT, GenRecon) missing.
export DINOV3_URL=

# Optional — a mirror of the weights, tried before the official sources: a directory or an http(s)
# base holding files named by their sha256 (scripts/rebuild/models.tsv).
# export STAC_MIRROR=
