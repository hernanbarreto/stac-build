+def _line_fit(x, y):
+    """(a, b) of the least-squares line y = a x + b: the normal equations in float64 (fixed-order reductions)."""
+    n = float(x.numel())
+    sx, sy, sxx, sxy = x.sum(), y.sum(), (x * x).sum(), (x * y).sum()
+    det = n * sxx - sx * sx
+    return float((n * sxy - sx * sy) / det), float((sxx * sy - sx * sxy) / det)
+
+
+def _light_record(p, T, keep, stride):
+    """STAC (2026-11-06): one saved frame of the light map — its depth along its own camera axis on the pixel-stride
+    grid (0 where the map drops the pixel), its pose in its submap, the pinhole K its full pass follows (StacDump's
+    least squares of u = fx x/z + cx, v = fy y/z + cy over the valid pixels, pixel centres at integers — here on the
+    card) and that fit's median pixel residual."""
+    Td = T.double()
+    pc = (p.double() - Td[:3, 3]) @ Td[:3, :3]
+    z = pc[..., 2]
+    H, W = z.shape
+    ok = torch.isfinite(pc).all(-1) & (z > 1e-6)
+    d = torch.where(keep & ok, z, torch.zeros_like(z))[::stride, ::stride].float().cpu()
+    if int(ok.sum()) < 3:
+        return d, Td.cpu(), (float('nan'),) * 4, float('nan')
+    v, u = torch.meshgrid(torch.arange(H, dtype=torch.float64, device=z.device),
+                          torch.arange(W, dtype=torch.float64, device=z.device), indexing='ij')
+    zs = torch.where(ok, z, torch.ones_like(z))
+    xs, ys, uo, vo = (pc[..., 0] / zs)[ok], (pc[..., 1] / zs)[ok], u[ok], v[ok]
+    fx, cx = _line_fit(xs, uo)
+    fy, cy = _line_fit(ys, vo)
+    r = torch.cat([(fx * xs + cx - uo).abs(), (fy * ys + cy - vo).abs()])
+    return d, Td.cpu(), (fx, fy, cx, cy), float(r.sort().values[r.numel() // 2])
+
