# =============================================
# STAC-Builder — Docker Build Exclusions
# =============================================

# Node modules (rebuilt inside container)
ui/node_modules/

# Build artifacts
ui/dist/
ui/dist-electron/
vendor/PotreeConverter/build/

# Scan data (runtime only)
server/scans/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/

# Environment
.env
.venv/

# Weights (mounted at runtime)
weights/

# Temp scripts
server/rematch_cloud.py
server/fix_vlm_prompt.py
server/check_dupes.py

# OS files
Thumbs.db
.DS_Store
