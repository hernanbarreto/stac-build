+def _stac_active_cells(points_path, chunk_centers, chunk_size: float, R: int, min_points: int) -> np.ndarray:
+    """STAC 2026-11-05: the centres of the ACTIVE voxels of the whole cloud on the lattice every cube's grid lies on.
+    A cube's voxel (i, j, k) covers [corner + i·v, corner + (i+1)·v) with v = chunk_size / R (the convention of
+    reconstruct_scene._coords_from_points); the strides between cubes are multiples of chunk_size/16 = 2 voxels, so
+    the grids of all the cubes are ONE lattice whose origin is the lowest cube's corner, and a voxel's count is the
+    same whichever cube holds it. A voxel is active with ``min_points`` points; its centre lies strictly inside every
+    cube whose grid contains it."""
+    P = np.load(points_path)
+    C = np.asarray(chunk_centers, np.float64)
+    v = float(chunk_size) / int(R)
+    o = C.min(0) - 0.5 * float(chunk_size)
+    off = (C - 0.5 * float(chunk_size) - o) / v
+    if np.abs(off - np.round(off)).max() > 1e-3:
+        raise RuntimeError(f"the cubes' grids are not one lattice (corner offsets {np.abs(off - np.round(off)).max():.4f} voxel)")
+    ijk = np.floor((P.astype(np.float64) - o) / v).astype(np.int64)
+    del P
+    lo = ijk.min(0); ijk -= lo; dims = ijk.max(0) + 1
+    key = (ijk[:, 0] * dims[1] + ijk[:, 1]) * dims[2] + ijk[:, 2]
+    del ijk
+    uniq, cnt = np.unique(key, return_counts=True)
+    act = uniq[cnt >= int(min_points)]
+    vox = np.stack([act // (dims[1] * dims[2]), (act // dims[2]) % dims[1], act % dims[2]], 1) + lo
+    return (o + (vox + 0.5) * v).astype(np.float64)
