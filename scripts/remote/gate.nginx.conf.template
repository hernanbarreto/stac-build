# STAC Build — THE GATE in front of the page when it is published outside the pod (scripts/remote_access.sh
# renders this file with the key and runs its own nginx on it; nothing here is the provider's nginx).
#
# USER 2026-11-20: "la idea es que pueda verlo desde cualquier navegador, sin necesidad de abrir la consola" — and
# the work PC cannot install a VPN client. The page is therefore reachable from the internet, and several of the
# backend's routes answer without a login: NOTHING passes this gate but a browser that once opened the secret link
# (/__gate?k=<key>), which leaves a cookie. Behind it: the interface's dev server, and the backend's own routes
# straight to the backend (the same list as the dev server's proxy, plus the built app) — no temp file, no buffer
# (a session's ZIP is 100 GB), websockets passed.
user root;
worker_processes 2;
pid __RUN__/nginx.pid;
error_log __RUN__/error.log warn;
events { worker_connections 1024; }
http {
    access_log off;                                  # (the key travels once in a query string)
    server_tokens off;
    absolute_redirect off;                           # (a redirect of ours never names 127.0.0.1)
    client_max_body_size 0;
    client_body_temp_path __TMP__/body;
    proxy_temp_path __TMP__/proxy;
    fastcgi_temp_path __TMP__/fastcgi;
    uwsgi_temp_path __TMP__/uwsgi;
    scgi_temp_path __TMP__/scgi;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_max_temp_file_size 0;
    proxy_connect_timeout 10s;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    map_hash_bucket_size 128;                        # (the key is 64 characters)
    map $http_upgrade $connection_upgrade { default upgrade; "" close; }
    map $cookie_stac_gate $gate_ok { default 0; "__KEY__" 1; }
    server {
        listen 127.0.0.1:__PORT__;
        location = /__gate {
            if ($arg_k = "__KEY__") {
                add_header Set-Cookie "stac_gate=__KEY__; Path=/; Max-Age=31536000; Secure; HttpOnly; SameSite=Lax";
                add_header Cache-Control "no-store";
                return 302 /;
            }
            return 403;
        }
        location ~ ^/(api|sessions|ws|slam|segments|mode|health|status|potree|app|static)(/|$) {
            if ($gate_ok = 0) { return 403; }
            proxy_pass https://127.0.0.1:__BACKEND__;
            proxy_ssl_verify off;                    # the backend's certificate is self-signed
            proxy_set_header Host localhost:__BACKEND__;
            proxy_redirect https://localhost:__BACKEND__/ /;   # (the backend's own redirects name the host it was given)
            proxy_redirect http://localhost:__BACKEND__/ /;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
        location / {
            if ($gate_ok = 0) { return 403; }
            proxy_pass http://[::1]:__PAGE__;
            proxy_set_header Host localhost:__PAGE__;   # the dev server answers its own name only
            proxy_redirect http://localhost:__PAGE__/ /;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }
}
